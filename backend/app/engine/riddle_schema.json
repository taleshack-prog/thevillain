{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RiddleGenerationSchema",
  "type": "object",
  "properties": {
    "scenario":       { "type": "string", "minLength": 40, "maxLength": 300 },
    "riddle":         { "type": "string", "minLength": 30, "maxLength": 250 },
    "correct_answer": { "type": "string", "minLength": 1,  "maxLength": 60 },
    "distractors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 60 },
      "minItems": 3, "maxItems": 3
    },
    "deduction_steps": {
      "type": "array",
      "items": { "type": "string", "minLength": 10, "maxLength": 150 },
      "minItems": 2, "maxItems": 4
    },
    "clues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tier": { "type": "integer", "minimum": 1, "maximum": 3 },
          "text": { "type": "string", "minLength": 10, "maxLength": 150 }
        },
        "required": ["tier", "text"],
        "additionalProperties": false
      },
      "minItems": 3, "maxItems": 3
    }
  },
  "required": ["scenario", "riddle", "correct_answer", "distractors", "deduction_steps", "clues"],
  "additionalProperties": false
}
