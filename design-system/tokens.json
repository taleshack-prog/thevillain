{
  "$schema": "https://vilao.hacktech.farm/schema/tokens-v3.json",
  "meta": {
    "product": "O Vilao",
    "revision": "3.0",
    "rule_60_30_10": "60% carvao/superficies · 30% sombras estruturais · 10% acentos luminescentes",
    "forbidden": ["#00FFFF", "#FF00FF"]
  },
  "color": {
    "carvao_profundo":   { "hex": "#1A1A1A", "role": "Fundo principal, loading, canvas base" },
    "carvao_escuro":     { "hex": "#121212", "role": "Cards elevados, modais, gavetas, menus" },
    "carvao_medio":      { "hex": "#2A2A2A", "role": "Divisorias, bordas, estados inativos" },
    "roxo_real":         { "hex": "#6A3FA0", "role": "Vilao: cabecalhos do Curador, bordas, insignias" },
    "roxo_profundo":     { "hex": "#3D1F6E", "role": "Baloes de fala do Vilao, banners, areas de perigo" },
    "roxo_neon":         { "hex": "#8B5CF6", "role": "Circuitos ativos, glow de validacao, rim light" },
    "verde_esmeralda":   { "hex": "#22C55E", "role": "Heroi: trilhas de deducao, acoes, HUD de fuga" },
    "verde_neon":        { "hex": "#39FF14", "role": "Runas ativas, acerto correto, glow de vitoria" },
    "dourado_primario":  { "hex": "#D4AF37", "role": "Prestigio, Tier Filosofico, coroas, CTAs" },
    "dourado_claro":     { "hex": "#F0D98C", "role": "Titulos de alta hierarquia, recordes, selos" },
    "texto_primario":    { "hex": "#F5F5F5", "role": "Tipografia principal" },
    "texto_secundario":  { "hex": "#9E9E9E", "role": "Metadados, rotulos, prazos, legendas" },
    "feedback_sucesso":  { "hex": "#27AE60", "role": "Validacao positiva, acerto sem penalidade" },
    "feedback_erro":     { "hex": "#C0392B", "role": "Dano, perda de vidas, falha critica" }
  },
  "typography": {
    "display": { "family": "Cinzel", "role": "Titulos H1-H3, nomes de enigmas, dialogos do Vilao" },
    "body":    { "family": "Inter", "role": "Texto corrido, enunciados, opcoes, botoes de UI" },
    "mono":    { "family": "Roboto Mono", "role": "Cronometros, vidas, pontuacao, hashes, telemetria" }
  },
  "a11y": { "min_contrast": "WCAG AA 4.5:1", "min_touch_target_px": 44 }
}
