# ─── Aplicação ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="O Vilao API"
API_V1_PREFIX=/api/v1

# ─── Banco (PostgreSQL 16 nativo — Zero-Supabase) ─────────────────────────────
# Se a porta 5432 do host já estiver ocupada (ex.: PostgreSQL local do sistema),
# defina POSTGRES_HOST_PORT=5433 AQUI e troque a porta em DATABASE_URL para 5433.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
DATABASE_URL=postgresql+asyncpg://vilao:vilao@localhost:5432/vilao
POSTGRES_USER=vilao
POSTGRES_PASSWORD=vilao
POSTGRES_DB=vilao

# ─── Cache / Fila ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ─── Segurança / Anti-cheat / LGPD ────────────────────────────────────────────
SESSION_HMAC_SECRET=troque-por-um-segredo-de-32+bytes
TELEMETRY_SALT=troque-por-um-salt-rotativo
JWT_SECRET=troque-por-um-segredo-jwt
JWT_ALGORITHM=HS256

# ─── Inferência IA (pipeline de geração) ──────────────────────────────────────
# LLM_PROVIDER: "mock" (determinístico, sem download) ou "ollama" (SLM local).
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct-q4_0
OLLAMA_TIMEOUT=120

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:19006
